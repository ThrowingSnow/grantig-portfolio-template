    "./styles.css": "./styles/index.css"
  },
  "files": ["dist", "styles"],
  "scripts": {
    "build": "node ./build.mjs && tsc -p tsconfig.json --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2"
  }
}
