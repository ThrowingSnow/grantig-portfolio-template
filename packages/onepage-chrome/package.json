{
  "name": "onepage-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "React chrome components and design tokens from the one-page WebGL demo.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
